rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The news feed is public read-only content; only the Cloud Function
    // (Admin SDK, which bypasses these rules) ever writes to it.
    match /news/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
