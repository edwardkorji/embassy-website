rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The news feed is public read-only content; only the Cloud Function
    // (Admin SDK, which bypasses these rules) ever writes to it.
    match /news/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isNonEmptyString(value) {
      return value is string && value.size() > 0;
    }

    // Publications (monthly reports / academic articles) are public-read.
    // Signed-in staff (the dashboard) write directly; the shape check below
    // guards against a client bug corrupting public-facing data — it's not
    // a defense against a compromised account.
    match /publications/{publicationId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isNonEmptyString(request.resource.data.title)
        && request.resource.data.type in ["report", "article"]
        && isNonEmptyString(request.resource.data.fileUrl);
      allow delete: if isSignedIn();
    }

    // Blog posts follow the same pattern.
    match /blogs/{blogId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isNonEmptyString(request.resource.data.title)
        && request.resource.data.photos is list;
      allow delete: if isSignedIn();
    }

    // Team roster shown on the public "Meet the team" section.
    match /team/{memberId} {
      allow read: if true;
      allow create, update: if isSignedIn()
        && isNonEmptyString(request.resource.data.name)
        && isNonEmptyString(request.resource.data.role)
        && request.resource.data.order is number;
      allow delete: if isSignedIn();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
