rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // The news feed is public read-only content; only the Cloud Function
    // (Admin SDK, which bypasses these rules) ever writes to it.
    match /news/{articleId} {
      allow read: if true;
      allow write: if false;
    }

    match /meta/{docId} {
      allow read: if true;
      allow write: if false;
    }

    // Publications (monthly reports / academic articles) are public-read.
    // The stub doc is created by the Storage-triggered Cloud Function, and
    // an admin fills in the summary/author/type by hand in the Firebase
    // Console — both paths use Admin SDK / IAM access and bypass these
    // rules, so no client write path is granted here either.
    match /publications/{publicationId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
